{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!playground/generated",
      "!test/fixtures/generated",
      "!test/fixtures/specs",
      "!test/fixtures/broken",
      "!test/fixtures/next-major",
      "!playground/specs",
      "!patches",
      "!pnpm-lock.yaml",
      "!.claude",
      "!skills",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noNonNullAssertion": "off" },
      "correctness": { "useHookAtTopLevel": "off", "noComponentHookFactories": "off" },
      "a11y": { "useButtonType": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
