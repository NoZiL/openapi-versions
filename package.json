{
  "name": "openapi-versions",
  "version": "0.0.0",
  "description": "Multi-version OpenAPI client for the openapi-ts ecosystem: merges the minor specs of one API major, generates tolerant types with openapi-typescript, and gates features at runtime.",
  "scripts": {
    "codegen:playground": "rm -rf playground/generated && tsx codegen/cli.ts --config playground/openapi-versions.config.json",
    "codegen:test": "rm -rf test/fixtures/generated && tsx codegen/cli.ts --config test/fixtures/openapi-versions.config.json",
    "codegen": "pnpm codegen:playground && pnpm codegen:test",
    "check:breaking": "tsx codegen/cli.ts --check-only --config playground/openapi-versions.config.json",
    "typecheck": "pnpm codegen:test && pnpm codegen:playground && tsc --noEmit",
    "test": "pnpm codegen:test && vitest run",
    "playground": "pnpm codegen:playground && vite --config playground/app/vite.config.ts",
    "playground:api": "pnpm codegen:playground && tsx playground/api/run.ts",
    "build:playground": "pnpm codegen:playground && vite build --config playground/app/vite.config.ts",
    "build": "tsup",
    "prepack": "pnpm build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoZiL/openapi-versions.git"
  },
  "homepage": "https://github.com/NoZiL/openapi-versions#readme",
  "bugs": {
    "url": "https://github.com/NoZiL/openapi-versions/issues"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-helpers": "^0.1.0",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "bin": {
    "openapi-versions": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    },
    "./schema.json": "./openapi-versions.schema.json"
  },
  "files": [
    "dist",
    "openapi-versions.schema.json",
    "docs",
    "skills",
    "patches"
  ],
  "keywords": [
    "openapi",
    "openapi-typescript",
    "openapi-fetch",
    "openapi-react-query",
    "api-versioning",
    "semver",
    "codegen"
  ],
  "peerDependencies": {
    "openapi-typescript": "^7.13.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "openapi-typescript-helpers": "^0.1.0",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "openapi-react-query": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  }
}
